APP_NAME=contextcon05
DEBUG=false

# Postgres (used by docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Connection URLs for running the app/alembic on the host.
# docker-compose overrides these for the backend container to use the service hostnames db and redis.
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5433/app
REDIS_URL=redis://localhost:6380/0
