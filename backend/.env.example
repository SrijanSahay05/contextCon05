APP_NAME=contextcon05
DEBUG=false

# Postgres (used by docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Mongo (used by docker-compose)
MONGO_USER=app
MONGO_PASSWORD=change-me
MONGO_DB=app

# Connection URLs for running the app/alembic on the host.
# docker-compose overrides these for the backend container to use the service hostnames db and mongo.
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5433/app
MONGO_URL=mongodb://app:change-me@localhost:27017
