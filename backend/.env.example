APP_NAME=contextcon05
DEBUG=false

# Postgres (used by docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Mongo (used by docker-compose)
MONGO_USER=app
MONGO_PASSWORD=change-me
MONGO_DB=app

# Connection URLs for running the app/alembic on the host.
# docker-compose overrides these for the backend container to use the service hostnames db and mongo.
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5433/app
MONGO_URL=mongodb://app:change-me@localhost:27017

# Crustdata + LLM (only needed for live calls; tests use fakes)
CRUSTDATA_API_KEY=your-crustdata-key
# LLM through OpenRouter; attach your Anthropic key in OpenRouter as BYOK
OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_FAST_MODEL=anthropic/claude-haiku-5.5
# CACHE_MAX_AGE_HOURS=24

# Per-run limits
# RUN_CREDIT_CEILING=300
# RUN_DEADLINE_MINUTES=20

# Search relevance
# SEARCH_MODE=hybrid
# SEARCH_FOUNDED_FROM_YEAR=2016
# SEARCH_ENRICH_CAP=15
# SEARCH_CONCEPT_MIN_FIT=2

# Shared secret for the Crustdata watch webhook
WEBHOOK_SECRET=change-me

# Gmail (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/gmail/callback
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# DD timers and uploads
# DD_REMINDER_DAYS=5
# DD_TIMEOUT_DAYS=14
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_MB=25
