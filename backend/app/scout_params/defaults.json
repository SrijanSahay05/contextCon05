    "watch_min_score": 50
  },
  "run": {
    "top_n": 10,
    "credit_budget": 130,
    "profiling_budget": 30,
    "time_limit_s": 600,
    "post_window_months": 12,
    "portfolio_sample_max": 25,
    "max_staleness_days": 90,
